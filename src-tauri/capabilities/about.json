{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "about-capability",
  "description": "Allows the About window to open only the canonical Crypto Top repository URL",
  "windows": ["about"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/ArchLinuxStudio/btc-price-monitor"
        }
      ]
    }
  ]
}
